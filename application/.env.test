# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
# Base name "symfony"; the test env appends the "_test" suffix (see doctrine.yaml) => symfony_test
DATABASE_URL="mysql://symfony:symfony@db:3306/symfony?serverVersion=10.6.4-MariaDB&charset=utf8mb4"
MAILER_DSN=null://null
# The portal's address book is answered by a MockHttpClient in the tests; the
# values only have to be there so the service counts as configured.
PORTAL_API_URL=http://portal.example
PORTAL_API_TOKEN=test-token
