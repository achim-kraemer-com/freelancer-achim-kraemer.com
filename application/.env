# Vorgaben fuer alle Umgebungen — diese Datei liegt im Repo und enthaelt
# ausschliesslich unverfaengliche Werte fuer den lokalen Docker-Stack.
#
# Echte Werte (APP_SECRET, Datenbank, SMTP) gehoeren in .env.local. Die Datei
# ist nicht im Repo, wird nach dieser hier geladen und gewinnt damit. Auf dem
# Server steht sie deshalb nicht zur Dekoration da: ohne sie liefe die
# Anwendung mit den Vorgaben von unten.
#
# Ladereihenfolge: .env -> .env.local -> .env.$APP_ENV -> .env.$APP_ENV.local;
# echte Umgebungsvariablen schlagen alle Dateien.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=ChangeMe
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Zugangsdaten des Compose-Stacks (docker/docker-compose.yml), kein Geheimnis.
DATABASE_URL="mysql://symfony:symfony@db:3306/symfony?serverVersion=10.6.4-MariaDB&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
# Lokal: Mailcatcher (Web-UI auf http://localhost:1081).
MAILER_DSN=smtp://mailcatcher:25
###< symfony/mailer ###
