{# Symbole als eingebettetes SVG, nach dem Vorbild des Portals
   (portal/_symbol.html.twig).

   Nicht als Zeichen aus der Schrift: Lexend enthält weder ✉ noch ⏱ oder ↗.
   Der Browser nähme dafür irgendeine Schrift, die der Rechner gerade hat –
   auf dem einen ein farbiges Emoji, auf dem anderen ein Kästchen. Ein SVG
   steht im Quelltext und sieht überall gleich aus; es nimmt die Farbe des
   Textes (currentColor) und wächst mit der Schriftgröße (1.15em).

   Aufruf: {{ include('_symbol.html.twig', {name: 'kunden'}) }} #}
{# width/height stehen am Element, nicht nur in der CSS: Ein SVG ohne eigene
   Groesse waechst sonst auf die volle Breite seines Kastens, sobald die CSS
   einmal nicht da ist. Die Regeln fuer .symbol gewinnen trotzdem. #}
<svg class="symbol symbol-{{ name }}" viewBox="0 0 24 24" width="20" height="20"
     fill="none" stroke="currentColor"
     stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"
     aria-hidden="true" focusable="false">
    {%- if name == 'uebersicht' -%}
        <rect x="3.5" y="3.5" width="7" height="7" rx="1.5"/>
        <rect x="13.5" y="3.5" width="7" height="7" rx="1.5"/>
        <rect x="3.5" y="13.5" width="7" height="7" rx="1.5"/>
        <rect x="13.5" y="13.5" width="7" height="7" rx="1.5"/>
    {%- elseif name == 'kunden' -%}
        <rect x="3.5" y="7.5" width="17" height="12.5" rx="2"/>
        <path d="M9 7.5V5.8A1.8 1.8 0 0 1 10.8 4h2.4A1.8 1.8 0 0 1 15 5.8v1.7M3.5 12.5h17"/>
    {%- elseif name == 'rechnungen' -%}
        <path d="M14 3.5H7.5a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2h9a2 2 0 0 0 2-2V8z"/>
        <path d="M14 3.5V8h4.5M9 12.5h6M9 16h3.5"/>
    {%- elseif name == 'zeiten' -%}
        <circle cx="12" cy="12" r="8.5"/>
        <path d="M12 7.3V12l3.2 1.9"/>
    {%- elseif name == 'signaturen' -%}
        <path d="M3.5 16.2c2.4 0 2.9-8.7 4.9-8.7s1.5 8.7 3.4 8.7 2.1-4.8 3.9-4.8c1.1 0 1.8 1.4 1.8 2.5"/>
        <path d="M3.5 20.2h17"/>
    {%- elseif name == 'benutzer' -%}
        <circle cx="12" cy="8.5" r="4"/>
        <path d="M4.5 20.5c.8-3.9 3.8-6 7.5-6s6.7 2.1 7.5 6"/>
    {%- elseif name == 'modelle' -%}
        <path d="m11 3.5 1.9 5.1 5.1 1.9-5.1 1.9L11 17.5 9.1 12.4 4 10.5l5.1-1.9z"/>
        <path d="m18 15.5.9 2.3 2.3.9-2.3.9-.9 2.3-.9-2.3-2.3-.9 2.3-.9z"/>
    {%- elseif name == 'profil' -%}
        <circle cx="12" cy="12" r="3"/>
        <path d="M12 3v2.5M12 18.5V21M3 12h2.5M18.5 12H21M5.6 5.6l1.8 1.8M16.6 16.6l1.8 1.8M5.6 18.4l1.8-1.8M16.6 7.4l1.8-1.8"/>
    {%- elseif name == 'website' -%}
        <path d="M19 13.5v5a1.5 1.5 0 0 1-1.5 1.5h-11A1.5 1.5 0 0 1 5 18.5v-11A1.5 1.5 0 0 1 6.5 6h5"/>
        <path d="M14.5 4H20v5.5M20 4l-8.2 8.2"/>
    {%- elseif name == 'logout' -%}
        <path d="M15.5 8V5.8A1.8 1.8 0 0 0 13.7 4H6.3a1.8 1.8 0 0 0-1.8 1.8v12.4A1.8 1.8 0 0 0 6.3 20h7.4a1.8 1.8 0 0 0 1.8-1.8V16"/>
        <path d="M19.5 12H9.5m7-3 3 3-3 3"/>
    {%- elseif name == 'mehr' -%}
        <circle cx="5.5" cy="12" r="1.4" fill="currentColor" stroke="none"/>
        <circle cx="12" cy="12" r="1.4" fill="currentColor" stroke="none"/>
        <circle cx="18.5" cy="12" r="1.4" fill="currentColor" stroke="none"/>
    {%- endif -%}
</svg>
