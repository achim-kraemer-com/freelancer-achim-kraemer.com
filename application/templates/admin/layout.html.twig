{% extends 'base.html.twig' %}

{% block body %}
    {{ include('_admin_nav.html.twig') }}

    <main class="admin-main">
        {% block flashes %}
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="flashes">
                        <div class="flash flash-{{ type == 'error' ? 'error' : 'success' }}">{{ message }}</div>
                    </div>
                {% endfor %}
            {% endfor %}
        {% endblock %}

        {% block admin_body %}{% endblock %}
    </main>
{% endblock %}
