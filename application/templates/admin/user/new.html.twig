{% extends 'admin/layout.html.twig' %}

{% block title %}Neuer Benutzer · Freelancer-CRM{% endblock %}

{% block admin_body %}
    <div class="breadcrumb"><a href="{{ path('admin_user_index') }}">Benutzer</a> / Neu</div>

    <div class="page-head">
        <div><h1>Neuer Benutzer</h1></div>
    </div>

    <div class="card form-card">
        {{ form_start(form) }}
            {{ form_errors(form) }}
            <div class="form-row">{{ form_label(form.email) }}{{ form_widget(form.email) }}{{ form_errors(form.email) }}</div>
            <div class="form-row">{{ form_label(form.role) }}{{ form_widget(form.role) }}{{ form_errors(form.role) }}</div>
            <div class="form-row">{{ form_label(form.plainPassword) }}{{ form_widget(form.plainPassword) }}{{ form_errors(form.plainPassword) }}</div>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Anlegen</button>
                <a href="{{ path('admin_user_index') }}" class="btn btn-ghost">Abbrechen</a>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
