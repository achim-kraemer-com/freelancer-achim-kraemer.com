{% extends 'admin/layout.html.twig' %}

{% block title %}Rechnung {{ invoice.number }} · Freelancer-Pro{% endblock %}

{% block admin_body %}
    <div class="breadcrumb"><a href="{{ path('admin_invoice_index') }}">Rechnungen</a> / {{ invoice.number }}</div>

    <div class="page-head">
        <div>
            <h1>Rechnung {{ invoice.number }}</h1>
            <p class="sub">
                <span class="status status-{{ invoice.status }}">{{ invoice.status|capitalize }}</span>
                {% if invoice.overdue %}<span class="status status-overdue">Überfällig</span>{% endif %}
            </p>
        </div>
        <div class="head-actions">
            <a href="{{ path('admin_invoice_download', {id: invoice.id}) }}" class="btn btn-ghost">PDF herunterladen</a>
            {% if invoice.customer.email %}
                <form method="post" action="{{ path('admin_invoice_send', {id: invoice.id}) }}" class="inline-form"
                      onsubmit="return confirm('Rechnung per E-Mail an {{ invoice.customer.email|e('js') }} senden?{{ invoice.signature ? (' Signatur: ' ~ invoice.signature.label)|e('js') : ' Ohne Signatur.' }}');">
                    <input type="hidden" name="_token" value="{{ csrf_token('send' ~ invoice.id) }}">
                    <button class="btn btn-primary">Per E-Mail senden</button>
                </form>
            {% endif %}
        </div>
    </div>

    <div class="detail-grid">
        <div class="card detail-card">
            <h3>Rechnung</h3>
            <dl>
                <dt>Nummer</dt><dd>{{ invoice.number }}</dd>
                <dt>Datum</dt><dd>{{ invoice.invoiceDate|date('d.m.Y') }}</dd>
                <dt>Betrag</dt><dd>{{ invoice.totalAmount|number_format(2, ',', '.') }} €</dd>
                <dt>Vorlage</dt><dd>{{ invoice.template.label }}</dd>
                <dt>Signatur</dt><dd>{% if invoice.signature %}{{ invoice.signature.label }}{% else %}<span class="muted">keine</span>{% endif %}</dd>
                <dt>Fällig</dt>
                <dd>
                    {% if invoice.dueDate %}
                        <span class="{{ invoice.overdue ? 'overdue-text' }}">{{ invoice.dueDate|date('d.m.Y') }}</span>
                        {% if invoice.overdue %}
                            <span class="muted">({{ (invoice.daysUntilDue * -1) }} Tage überfällig)</span>
                        {% elseif invoice.status != 'bezahlt' and invoice.daysUntilDue is not null %}
                            <span class="muted">(in {{ invoice.daysUntilDue }} Tagen)</span>
                        {% endif %}
                    {% else %}
                        <span class="muted">—</span>
                    {% endif %}
                </dd>
                {% if invoice.paidAt %}<dt>Bezahlt am</dt><dd>{{ invoice.paidAt|date('d.m.Y') }}</dd>{% endif %}
                <dt>Verschickt</dt>
                <dd>
                    {% if invoice.lastSentAt %}
                        {{ invoice.lastSentAt|date('d.m.Y H:i') }} Uhr
                        {% if invoice.dispatches|length > 1 %}<span class="muted">({{ invoice.dispatches|length }}×)</span>{% endif %}
                    {% else %}
                        <span class="muted">noch nicht per E-Mail versendet</span>
                    {% endif %}
                </dd>
            </dl>
        </div>
        <div class="card detail-card">
            <h3>Kunde &amp; Projekt</h3>
            <dl>
                <dt>Kunde</dt><dd><a href="{{ path('admin_customer_show', {id: invoice.customer.id}) }}">{{ invoice.customer }}</a></dd>
                {% if invoice.project %}<dt>Projekt</dt><dd><a href="{{ path('admin_project_show', {id: invoice.project.id}) }}">{{ invoice.project.name }}</a></dd>{% endif %}
            </dl>
        </div>
    </div>

    <div class="section">
        <div class="section-head"><h2>E-Mail-Signatur</h2></div>
        {% if signatures is empty %}
            <div class="empty">
                Noch keine Signatur angelegt – die Rechnung wird ohne Signatur versendet.
                <div style="margin-top:1rem"><a href="{{ path('admin_signature_new') }}" class="btn btn-ghost btn-sm">Signatur anlegen</a></div>
            </div>
        {% else %}
            {# The signature is a part of its own and is only put under the
               text when sending – so an HTML signature never has to live in a
               textarea. The preview shows the chosen one; the script follows
               the selection, without it the stored choice stays visible. #}
            <form method="post" action="{{ path('admin_invoice_signature', {id: invoice.id}) }}" class="signature-choice" data-signatur-wahl>
                <input type="hidden" name="_token" value="{{ csrf_token('signature' ~ invoice.id) }}">
                <div class="form-row">
                    <label for="signature">Signatur</label>
                    <select id="signature" name="signature">
                        <option value="">Keine</option>
                        {% for signature in signatures %}
                            <option value="{{ signature.id }}" {{ invoice.signature and invoice.signature.id == signature.id ? 'selected' }}>{{ signature.label }}</option>
                        {% endfor %}
                    </select>
                    {% for signature in signatures %}
                        {# Preview per signature; HTML is already defused by the MailSanitizer.
                           Signatures are designed for light mail clients – hence on white. #}
                        <div class="signature-preview message-html" data-signatur-vorschau="{{ signature.id }}"
                             {{ not (invoice.signature and invoice.signature.id == signature.id) ? 'hidden' }}>
                            {% if signature.isHtml %}
                                {{ previews[signature.id]|raw }}
                            {% else %}
                                <pre class="signature-plain">{{ signature.asBlock }}</pre>
                            {% endif %}
                        </div>
                    {% endfor %}
                    <span class="form-help">
                        Kommt beim Versand unter den Text der E-Mail.
                        Angelegt werden Signaturen unter <a href="{{ path('admin_signature_index') }}">Signaturen</a>.
                    </span>
                </div>
                <div class="head-actions">
                    <button class="btn btn-ghost btn-sm">Signatur speichern</button>
                </div>
            </form>
        {% endif %}
    </div>

    {% if invoice.dispatches is not empty %}
        <div class="section">
            <div class="section-head"><h2>E-Mail-Versand</h2></div>
            <div class="table-wrap">
                <table class="data">
                    <thead>
                        <tr><th>Gesendet am</th><th>Empfänger</th></tr>
                    </thead>
                    <tbody>
                        {% for dispatch in invoice.dispatches %}
                            <tr>
                                <td>{{ dispatch.sentAt|date('d.m.Y H:i') }} Uhr</td>
                                <td class="muted">{{ dispatch.recipient }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}

    <div class="section">
        <div class="section-head"><h2>Positionen</h2></div>
        <div class="table-wrap">
            <table class="data">
                <thead>
                    <tr><th style="width:2rem;">#</th><th>Aufgabe</th><th class="num">Stunden</th><th class="num">Kosten (€)</th></tr>
                </thead>
                <tbody>
                    {% for task in invoice.tasks %}
                        <tr>
                            <td>{{ loop.index }}</td>
                            <td>{{ task.name }}{% if task.description %}<div class="muted">{{ task.description|nl2br }}</div>{% endif %}</td>
                            <td class="num">{{ task.hours ? task.hours|number_format(2, ',', '.') ~ ' Std.' : '—' }}</td>
                            <td class="num">{{ task.cost|number_format(2, ',', '.') }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="3" class="num"><strong>Gesamt</strong></td>
                        <td class="num"><strong>{{ invoice.totalAmount|number_format(2, ',', '.') }} €</strong></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

    <div class="section">
        <div class="section-head"><h2>Status ändern</h2></div>
        <div class="head-actions">
            {% for label, value in constant('App\\Entity\\Invoice::STATUS_CHOICES') %}
                <form method="post" action="{{ path('admin_invoice_status', {id: invoice.id}) }}" class="inline-form">
                    <input type="hidden" name="_token" value="{{ csrf_token('status' ~ invoice.id) }}">
                    <input type="hidden" name="status" value="{{ value }}">
                    <button class="btn btn-sm {{ invoice.status == value ? 'btn-primary' : 'btn-ghost' }}"
                            {{ invoice.status == value ? 'disabled' }}>{{ label }}</button>
                </form>
            {% endfor %}
        </div>
    </div>

    <div class="section">
        <div class="section-head"><h2>Fälligkeit</h2></div>
        <form method="post" action="{{ path('admin_invoice_due_date', {id: invoice.id}) }}" class="head-actions" style="align-items:flex-end; gap:0.75rem;">
            <input type="hidden" name="_token" value="{{ csrf_token('due-date' ~ invoice.id) }}">
            <input type="date" name="due_date" value="{{ invoice.dueDate ? invoice.dueDate|date('Y-m-d') }}" style="width:auto;">
            <button class="btn btn-ghost btn-sm">Fälligkeit speichern</button>
        </form>
    </div>

    <form method="post" action="{{ path('admin_invoice_delete', {id: invoice.id}) }}"
          onsubmit="return confirm('Rechnung löschen? Die Aufgaben werden wieder als offen markiert.');" style="margin-top:2.5rem;">
        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ invoice.id) }}">
        <button class="btn btn-danger btn-sm">Rechnung löschen</button>
    </form>

    <script>
        // The preview follows the selection. Without the script the preview of
        // the stored signature stays – the selection itself works regardless.
        (function () {
            var wahl = document.querySelector('[data-signatur-wahl]');

            if (!wahl) {
                return;
            }

            var auswahl = wahl.querySelector('select');

            auswahl.addEventListener('change', function () {
                wahl.querySelectorAll('[data-signatur-vorschau]').forEach(function (vorschau) {
                    vorschau.hidden = vorschau.dataset.signaturVorschau !== auswahl.value;
                });
            });
        })();
    </script>
{% endblock %}
