{% extends 'admin/layout.html.twig' %}

{% block title %}Kunden · Freelancer-CRM{% endblock %}

{% block admin_body %}
    <div class="page-head">
        <div>
            <h1>Kunden</h1>
            <p class="sub">{{ pagination.total }} Kunde(n) insgesamt</p>
        </div>
        <div class="head-actions">
            <a href="{{ path('admin_customer_new') }}" class="btn btn-primary">+ Neuer Kunde</a>
        </div>
    </div>

    <form method="get" action="{{ path('admin_customer_index') }}" class="list-toolbar">
        <input type="search" name="q" value="{{ q }}" placeholder="Suche nach Name, Firma oder E-Mail …">
        <select name="active">
            <option value="">Alle</option>
            <option value="active" {{ active == 'active' ? 'selected' }}>Nur aktive</option>
            <option value="inactive" {{ active == 'inactive' ? 'selected' }}>Nur inaktive</option>
        </select>
        <button class="btn btn-ghost btn-sm">Filtern</button>
        {% if q or active %}<a href="{{ path('admin_customer_index') }}" class="btn btn-ghost btn-sm">Zurücksetzen</a>{% endif %}
    </form>

    {% if pagination.items is empty %}
        <div class="empty">Keine Kunden gefunden.</div>
    {% else %}
        <div class="table-wrap">
            <table class="data">
                <thead>
                    <tr>
                        <th>Firma / Name</th>
                        <th>E-Mail</th>
                        <th>Ort</th>
                        <th class="num">Projekte</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for customer in pagination.items %}
                        <tr>
                            <td>
                                <a href="{{ path('admin_customer_show', {id: customer.id}) }}">
                                    {{ customer.companyName ?: (customer.firstname ~ ' ' ~ customer.lastname) }}
                                </a>
                                {% if customer.companyName %}<div class="muted">{{ customer.firstname }} {{ customer.lastname }}</div>{% endif %}
                            </td>
                            <td class="muted">{{ customer.email }}</td>
                            <td class="muted">{{ customer.plz }} {{ customer.city }}</td>
                            <td class="num">{{ customer.projects|length }}</td>
                            <td>
                                {% if customer.active %}
                                    <span class="status status-bezahlt">Aktiv</span>
                                {% else %}
                                    <span class="status status-verschickt">Inaktiv</span>
                                {% endif %}
                            </td>
                            <td class="num">
                                <a href="{{ path('admin_customer_edit', {id: customer.id}) }}" class="btn btn-ghost btn-sm">Bearbeiten</a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {{ include('_pagination.html.twig', {route: 'admin_customer_index', pagination: pagination, query: {q: q, active: active}}) }}
    {% endif %}
{% endblock %}
