<nav class="admin-nav">
    <a href="{{ path('app_dashboard') }}" class="brand">
        <img src="{{ asset('img/ak-mark-freelancer.svg') }}" alt="" class="brand-mark" width="64" height="64">
        Freelancer-Pro
    </a>
    {% if is_granted('ROLE_ADMIN') %}
        <div class="links">
            <a href="{{ path('admin_customer_index') }}" class="{{ app.request.attributes.get('_route') starts with 'admin_customer' or app.request.attributes.get('_route') starts with 'admin_project' or app.request.attributes.get('_route') starts with 'admin_task' ? 'active' }}">Kunden</a>
            <a href="{{ path('admin_invoice_index') }}" class="{{ app.request.attributes.get('_route') starts with 'admin_invoice' ? 'active' }}">Rechnungen</a>
            <a href="{{ path('admin_signature_index') }}" class="{{ app.request.attributes.get('_route') starts with 'admin_signature' ? 'active' }}">Signaturen</a>
            <a href="{{ path('admin_time_tracking_index') }}" class="{{ app.request.attributes.get('_route') starts with 'admin_time_tracking' ? 'active' }}">Zeiterfassung</a>
            <a href="{{ path('admin_user_index') }}" class="{{ app.request.attributes.get('_route') starts with 'admin_user' ? 'active' }}">Benutzer</a>
        </div>
    {% endif %}
    <span class="spacer"></span>
    <div class="links">
        <a href="{{ path('app_profile_index') }}" class="{{ app.request.attributes.get('_route') starts with 'app_profile' ? 'active' }}">Profil</a>
        <a href="{{ path('app_home') }}">Website</a>
        <a href="{{ path('app_logout') }}" class="btn btn-ghost btn-sm">Logout</a>
    </div>
</nav>
