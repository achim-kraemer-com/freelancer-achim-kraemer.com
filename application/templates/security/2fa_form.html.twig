{% extends 'base.html.twig' %}

{% block title %}Bestätigung · Achim Krämer · Freelancer{% endblock %}

{% block body %}
    <div class="auth-shell">
        <form method="post" action="{{ path('2fa_login_check') }}" class="card auth-card animate-in">
            <a href="{{ path('app_home') }}" class="brand">
                <img src="{{ asset('img/ak-lockup-freelancer.svg') }}" alt="Achim Krämer · Freelancer"
                     class="brand-lockup" width="280" height="64">
            </a>

            <h1>Zwei-Faktor-Bestätigung</h1>
            <p class="subtitle">Gib den 6-stelligen Code aus deiner Authenticator-App ein.</p>

            {% if authenticationError %}
                <div class="alert alert-danger">{{ authenticationError|trans(authenticationErrorData, 'SchebTwoFactorBundle') }}</div>
            {% endif %}

            <div class="field">
                <label for="_auth_code">Code</label>
                <input type="text" id="_auth_code" name="{{ authCodeParameterName }}"
                       inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]*"
                       placeholder="123456" required autofocus>
            </div>

            {% if displayTrustedOption %}
                <div class="field-row">
                    <label class="checkbox">
                        <input type="checkbox" name="{{ trustedParameterName }}"> Diesem Gerät vertrauen
                    </label>
                </div>
            {% endif %}

            {% if isCsrfProtectionEnabled %}
                <input type="hidden" name="{{ csrfParameterName }}" value="{{ csrf_token(csrfTokenId) }}">
            {% endif %}

            <button type="submit" class="btn btn-primary btn-block">Bestätigen</button>

            <p class="auth-footer">
                <a href="{{ logoutPath }}">Abbrechen &amp; abmelden</a>
            </p>
        </form>
    </div>
{% endblock %}
