# Vorlage fuer .env. Symfony liest diese Datei, solange keine .env daneben
# liegt — also in einem frischen Clone und in CI. Die echte .env ist nicht im
# Repo (sie enthaelt Secrets) und gewinnt, wo sie existiert.
#
# Hier stehen nur unverfaengliche Vorgaben fuer die lokale Docker-Umgebung.
# Echte Werte gehoeren in .env.local, niemals in eine getrackte Datei.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=ChangeMe
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Zugangsdaten des Compose-Stacks (docker/docker-compose.yml), kein Geheimnis.
DATABASE_URL="mysql://symfony:symfony@db:3306/symfony?serverVersion=10.6.4-MariaDB&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
# Lokal: Mailcatcher (Web-UI auf http://localhost:1081).
MAILER_DSN=smtp://mailcatcher:25
###< symfony/mailer ###
